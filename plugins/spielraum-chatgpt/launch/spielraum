#!/bin/sh
set -eu

# Follow the host-runtime lookup used by OpenAI's Codex Security plugin.
server_path=${0%/*}/../dist/stdio.js
codex_resources=
case "${CODEX_CLI_PATH:-}" in
  */*) codex_resources=${CODEX_CLI_PATH%/*} ;;
esac
cache_root=${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}

for candidate in \
  "${CODEX_MCP_NODE_PATH:-}" \
  "${CODEX_BROWSER_USE_NODE_PATH:-}" \
  "${CODEX_ELECTRON_RESOURCES_PATH:+$CODEX_ELECTRON_RESOURCES_PATH/cua_node/bin/node}" \
  "${codex_resources:+$codex_resources/cua_node/bin/node}" \
  "${cache_root:+$cache_root/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node}"
do
  if [ -n "$candidate" ] && [ -f "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$server_path" "$@"
  fi
done

if node_path=$(command -v node) && [ -n "$node_path" ]; then
  exec "$node_path" "$server_path" "$@"
fi

printf '%s\n' 'Spielraum could not find Node.js 24+. Update the desktop app or set CODEX_MCP_NODE_PATH to an executable Node runtime.' >&2
exit 127
